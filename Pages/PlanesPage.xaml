<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GitFlightApp.Models"
             x:Class="GitFlightApp.Pages.PlanesPage"
             Title="Planes">

    <ScrollView>
        <VerticalStackLayout Padding="10">
            <Label Text="Planes" HorizontalOptions="Center" FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Planes}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="8" Margin="5">
                            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                <Frame WidthRequest="56" HeightRequest="56" CornerRadius="8" Padding="0" HasShadow="False" BackgroundColor="#eee">
                                    <Image Source="{Binding ImagePath}" Aspect="AspectFill" />
                                </Frame>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Model}" FontAttributes="Bold" />
                                    <Label Text="{Binding Manufacturer}" FontSize="12" TextColor="Gray" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Agregar avión" Clicked="OnAddNewPlaneClicked" HorizontalOptions="Center" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>