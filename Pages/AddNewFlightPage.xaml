<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GitFlightApp.Pages.AddNewFlightPage"
             Title="AddNewFlightPage">
    <VerticalStackLayout Padding="20">
        <Label 
        Text="Add Flight"
        FontSize="24"
        HorizontalOptions="Center" />
        <Entry x:Name="flightNumberEntry" Placeholder="Enter Flight Number Here"/>
        <Entry x:Name="departureDateEntry" Placeholder="Enter Flight Departure Date Here" Keyboard="Date"/>
        <Entry x:Name="priceEntry" Placeholder="Enter Flight Price Here" Keyboard="Telephone"/>

        <Button Text="Save" Clicked="OnSave"/>
        <Button Text="Cancel" Clicked="OnCancel"/>
    </VerticalStackLayout>
</ContentPage>